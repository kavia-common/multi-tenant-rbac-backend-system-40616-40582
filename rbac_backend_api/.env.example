# Example environment configuration for RBAC Backend API
# Copy this file to .env and adjust values for your environment.

# Application
PROJECT_NAME=RBAC Backend API
LOG_LEVEL=INFO

# CORS
CORS_ALLOW_ORIGINS=*

# Database configuration
# Either provide a full SQLAlchemy DSN in DB_DSN, or configure individual MYSQL_* vars.
# Example DSN: mysql+pymysql://user:password@host:3306/dbname
DB_DSN=
MYSQL_URL=localhost
MYSQL_PORT=3306
MYSQL_USER=rbac_user
MYSQL_PASSWORD=rbac_password
MYSQL_DB=rbac_db

# JWT configuration
# WARNING: Set a strong secret in production. If not set, application may warn but should not crash.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initialization / seeding (dev only)
# Set INIT_ALLOW=1 to enable /api/init/seed endpoint for development environments.
INIT_ALLOW=

# Site URL for external redirects (if used by clients)
SITE_URL=http://localhost:3001
