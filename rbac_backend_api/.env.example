# Application environment
APP_ENV=development
PROJECT_NAME=RBAC Backend API

# JWT configuration
JWT_SECRET_KEY=change_me_in_env
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60

# Database configuration
# Preferred: provide full SQLAlchemy DSN
# Example (MySQL with PyMySQL): mysql+pymysql://user:password@localhost:3306/database
DB_DSN=

# Alternative: path to db_connection.txt (MySQL CLI-like line: e.g., `mysql -uuser -ppassword database`)
# If not absolute, it is resolved relative to current working directory.
DB_CONNECTION_FILE=

# Optional overrides when using db_connection.txt parsing
DB_HOST=localhost
DB_PORT=3306
