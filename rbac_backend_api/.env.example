# Application environment
APP_ENV=development
PROJECT_NAME=RBAC Backend API

# JWT settings
JWT_SECRET_KEY=change_me_in_env
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60

# Enable init seeding endpoint (set to 1 to allow)
INIT_ALLOW=1

# Database configuration (choose one of the following approaches)

# 1) Direct SQLAlchemy DSN (MySQL)
# Example: mysql+pymysql://user:password@host:3306/database
# DB_DSN=

# 2) Path to a db_connection.txt (containing a mysql CLI like: mysql -uuser -ppassword -hhost -P3306 database)
# DB_CONNECTION_FILE=../rbac_mysql_database/db_connection.txt

# 3) MYSQL_* environment variables (used to build DSN automatically)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=
