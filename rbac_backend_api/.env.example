# Example environment variables for RBAC Backend API

# Application
PROJECT_NAME=RBAC Backend API
LOG_LEVEL=INFO

# JWT configuration
# IMPORTANT: Set a strong random secret in real environments.
# The application will not crash if this is missing during startup,
# but authentication endpoints will require a secret at runtime.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database configuration (optional for startup, required for DB-backed endpoints)
# Provide a full SQLAlchemy DSN or individual MySQL parameters.
# Example DSN: mysql+pymysql://user:password@host:3306/dbname
DB_DSN=
MYSQL_URL=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_PORT=3306

# Development seeding control
# Set to 1 to allow calling /api/init/seed in development environments.
INIT_ALLOW=0
