# Application
APP_ENV=development
PROJECT_NAME=RBAC Backend API

# JWT
JWT_SECRET_KEY=replace_with_strong_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60

# Database connection (choose one option below)
# Option 1: Direct DSN (highest priority)
# DB_DSN=mysql+pymysql://user:password@host:3306/database

# Option 2: Path to db_connection.txt file (mysql CLI format), relative to CWD or absolute
# DB_CONNECTION_FILE=../rbac_mysql_database/db_connection.txt

# Option 3: Standard MySQL environment variables (fallback if DB_DSN not set)
MYSQL_URL=localhost
MYSQL_USER=rbac_user
MYSQL_PASSWORD=rbac_password
MYSQL_DB=rbac_db
MYSQL_PORT=3306

# Optional alternative host/port names used by parser
# DB_HOST=localhost
# DB_PORT=3306
